{
  "version": 1,

  "kind": "game",

  "identity": {
    "github_owner": "your-github-login",
    "default_visibility": "private"
  },

  "git": {
    "merge_method": "squash",
    "commit_convention": "conventional",
    "branch_pattern": "{type}/{slug}",
    "delete_branch_on_merge": true
  },

  "board": {
    "enabled": true,
    "title": "{project} backlog",
    "columns": {
      "backlog": "Backlog",
      "ready": "Ready",
      "in_progress": "In Progress",
      "in_review": "In Review",
      "done": "Done"
    },
    "priorities": ["P1", "P2", "P3"]
  },

  "labels": {
    "types": ["feature", "bug", "chore", "docs"],
    "area_presets": {
      "game": ["gameplay", "ui", "audio", "build"],
      "web": ["frontend", "api", "data", "build"],
      "library": ["core", "docs", "build"],
      "other": ["core", "ui", "build"]
    }
  },

  "review": {
    "independent_review_required": true,
    "default_effort": "medium"
  },

  "ci": {
    "os": ["ubuntu-latest"]
  },

  "components": {
    "issue_and_pr_templates": true,
    "game_docs": true,
    "decisions_log": true,
    "pr_check_skill": true,
    "run_skill_and_toolchain": true,
    "ci": true,
    "merge_gate_hook": true,
    "cwd_guard_hook": true
  }
}
