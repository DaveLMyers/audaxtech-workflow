name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  # macOS is slow to get a runner (10+ minutes is common), so it runs only when
  # asked for: `gh workflow run CI -f macos=true` (or the Run workflow button).
  workflow_dispatch:
    inputs:
      macos:
        description: "Also run the macOS jobs"
        type: boolean
        default: false

# A rapid string of pushes to the same PR shouldn't queue a full run per push:
# cancel anything a newer run has made moot. Only for pull requests - a run on
# a main commit should always finish, or that commit never gets a result.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  test:
    name: Build + tests (${{ matrix.name }})
    runs-on: ${{ matrix.os }}
    # Every platform the project is meant to run on gets the same checks, each
    # as its own check, so a break on one shows up the day it is made. One
    # failing platform must not hide the others, so the rest keep running.
    # Cost: on a private repo the monthly Actions allowance is consumed faster
    # by macOS (about 10x) and Windows (about 2x) minutes than Linux; check
    # your plan's current numbers. macOS runs only on request (see `on:`), so
    # it costs nothing until asked for. Trim the matrix with `ci.matrix` in
    # .claude/workflow.json if usage grows.
    strategy:
      fail-fast: false
      matrix:
        # The matrix is built from the trigger: a job that is never created
        # leaves no check, whereas a job-level `if` cannot read the matrix and
        # leaves a skipped check. On a pull request `inputs.macos` is empty,
        # so only the first list runs.
        include: ${{ fromJSON(inputs.macos && '{{CI_MATRIX_WITH_MACOS}}' || '{{CI_MATRIX_ALWAYS}}') }}
    steps:
      - uses: actions/checkout@v4
{{CI_STEPS}}
