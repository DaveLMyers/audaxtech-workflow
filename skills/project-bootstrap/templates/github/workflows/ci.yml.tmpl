name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# A rapid string of pushes to the same PR/branch supersedes the in-flight run
# instead of queueing a full run per push.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  test:
    name: Build + tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # {{CI_SETUP_COMMENT}}
{{CI_STEPS}}
