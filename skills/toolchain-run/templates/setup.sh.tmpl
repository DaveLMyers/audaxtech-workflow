#!/usr/bin/env bash
# Sets up the @@TOOL@@ version pinned in @@PIN_FILE@@ under @@BIN_DIR@@/ (git-
# ignored), so nobody needs to install it system-wide or edit their PATH.
# Idempotent: re-running when the right version is already wired up does
# nothing. Produces a stable launcher at @@BIN_DIR@@/@@NAME@@ regardless of the
# archive's internal layout. See the "run" skill (.claude/skills/run/SKILL.md)
# for the commands that use it. CI should call this same script.
#
# Order of preference (the pinned version always wins - a candidate is only
# used if it reports exactly the pinned version):
#   1. already set up here at the right version  -> nothing to do
#   2. --existing <folder-or-exe>                -> use it, or fail loudly
#   3. $@@ENVVAR@@                      -> use it if it matches, else ignore
#   4. @@PATH_NAMES_DISPLAY@@ on PATH            -> use it if it matches, else ignore
#   5. download the pinned version
#
# Generated by the toolchain-run skill - edit the spec and re-render rather
# than hand-editing where possible.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="$(tr -d '[:space:]' < "$REPO_ROOT/@@PIN_FILE@@")"
VERSION_CORE="${VERSION%%-*}"
BIN_DIR="$REPO_ROOT/@@BIN_DIR@@"
SHIM="$BIN_DIR/@@NAME@@"
PATH_NAMES="@@PATH_NAMES@@"
MATCH_TEMPLATE='@@VERSION_MATCH@@'
MATCH="${MATCH_TEMPLATE//\{version_core\}/$VERSION_CORE}"
MATCH="${MATCH//\{version\}/$VERSION}"

EXISTING_ARG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --existing) EXISTING_ARG="${2:-}"; [ -n "$EXISTING_ARG" ] || { echo "--existing needs a path" >&2; exit 2; }; shift 2 ;;
    -h|--help) sed -n '2,17p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "Unknown argument: $1 (try --help)" >&2; exit 2 ;;
  esac
done

# SETUP_PLATFORM lets CI or a test force a platform (windows|linux|macos).
case "${SETUP_PLATFORM:-$(uname -s)}" in
  linux|Linux*) PLATFORM=linux ;;
  macos|Darwin*) PLATFORM=macos ;;
  windows|MINGW*|MSYS*|CYGWIN*) PLATFORM=windows ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

UNSUPPORTED=""
URL=""; ARCHIVE=""; BIN_REL=""
case "$PLATFORM" in
@@PLATFORM_CASES@@
esac

# Does this executable report the pinned version? (Compare against the
# version command's own output - its punctuation often differs from the tag.)
reports_pinned_version() {
  "$1" @@VERSION_ARGS@@ 2>/dev/null | grep -qF -- "$MATCH"
}

# Wire an existing install: nothing is copied, a small launcher is written.
# $1 = folder or executable, $2 = strict (fail loudly) | soft (skip quietly).
use_existing() {
  local cand="$1" mode="$2"
  if [ -d "$cand" ]; then cand="$cand/$(basename "${BIN_REL:-@@NAME@@}")"; fi
  [ "$cand" = "$SHIM" ] && return 1   # never wire the launcher to itself
  if [ ! -x "$cand" ]; then
    [ "$mode" = strict ] && { echo "Not an executable: $cand" >&2; exit 1; }
    return 1
  fi
  if reports_pinned_version "$cand"; then
    mkdir -p "$BIN_DIR"
    printf '#!/bin/sh\nexec "%s" "$@"\n' "$cand" > "$SHIM"
    chmod +x "$SHIM"
    echo "@@TOOL@@ $VERSION wired to existing install: $cand"
    echo "Launcher: $SHIM (git-ignored, machine-specific)"
    return 0
  fi
  local got
  got="$("$cand" @@VERSION_ARGS@@ 2>/dev/null | head -n1 || true)"
  if [ "$mode" = strict ]; then
    echo "'$cand' reports '${got:-nothing}' but @@PIN_FILE@@ pins $VERSION. Not using it." >&2
    echo "Update @@PIN_FILE@@ deliberately, or point --existing at a matching install." >&2
    exit 1
  fi
  echo "Found @@TOOL@@ at $cand reporting '${got:-nothing}', but this project pins $VERSION - ignoring it."
  return 1
}

# 2. An explicit --existing is a deliberate act: always re-validate, never skip.
if [ -n "$EXISTING_ARG" ]; then
  use_existing "$EXISTING_ARG" strict
  exit 0
fi

# 1. Already set up at the right version?
if [ -x "$SHIM" ] && reports_pinned_version "$SHIM"; then
  echo "@@TOOL@@ $VERSION already set up at $SHIM"
  exit 0
fi

# 3. Environment variable.
if [ -n "${@@ENVVAR@@:-}" ] && use_existing "${@@ENVVAR@@}" soft; then exit 0; fi

# 4. On PATH.
for n in $PATH_NAMES; do
  p="$(command -v "$n" 2>/dev/null || true)"
  if [ -n "$p" ] && use_existing "$p" soft; then exit 0; fi
done

# 5. Download the pinned version.
if [ -n "$UNSUPPORTED" ]; then
  printf '%s\n' "$UNSUPPORTED" >&2
  echo "Or pass --existing <path> / set @@ENVVAR@@ to a matching install." >&2
  exit 1
fi

echo "Setting up @@TOOL@@ $VERSION at $BIN_DIR ..."
mkdir -p "$BIN_DIR"
ARCHIVE_PATH="$(mktemp)"
trap 'rm -f "$ARCHIVE_PATH"' EXIT

echo "Downloading $URL"
# -f: fail on an HTTP error (bad pin, rate limit) instead of saving the error
# page as the archive and failing later with a confusing extract error.
curl -fsSL -o "$ARCHIVE_PATH" "$URL"

echo "Extracting..."
case "$ARCHIVE" in
  zip)    unzip -oq "$ARCHIVE_PATH" -d "$BIN_DIR" ;;
  tar.gz) tar -xzf "$ARCHIVE_PATH" -C "$BIN_DIR" ;;
  *) echo "Unknown archive type: $ARCHIVE" >&2; exit 1 ;;
esac

[ -e "$BIN_DIR/$BIN_REL" ] || { echo "Expected $BIN_DIR/$BIN_REL after extract - archive layout changed?" >&2; exit 1; }
chmod +x "$BIN_DIR/$BIN_REL" 2>/dev/null || true

# Stable, version-agnostic launcher (relative path, so a moved checkout works).
printf '#!/bin/sh\nexec "$(dirname "$0")/%s" "$@"\n' "$BIN_REL" > "$SHIM"
chmod +x "$SHIM"

echo "Done. @@TOOL@@ $VERSION is at $SHIM"
