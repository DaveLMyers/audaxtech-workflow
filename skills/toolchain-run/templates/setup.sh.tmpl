#!/usr/bin/env bash
# Fetches the @@TOOL@@ version pinned in @@PIN_FILE@@ into @@BIN_DIR@@/ (git-
# ignored), so nobody needs to install it system-wide or edit their PATH.
# Idempotent - re-running when the right version is already present does
# nothing. Produces a stable launcher at @@BIN_DIR@@/@@NAME@@ regardless of the
# archive's internal layout. See the "run" skill (.claude/skills/run/SKILL.md)
# for the commands that use it. CI should call this same script.
#
# Generated by the toolchain-run skill - edit the spec and re-render rather
# than hand-editing where possible.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="$(tr -d '[:space:]' < "$REPO_ROOT/@@PIN_FILE@@")"
VERSION_CORE="${VERSION%%-*}"
BIN_DIR="$REPO_ROOT/@@BIN_DIR@@"
SHIM="$BIN_DIR/@@NAME@@"
MATCH_TEMPLATE='@@VERSION_MATCH@@'
MATCH="${MATCH_TEMPLATE//\{version_core\}/$VERSION_CORE}"
MATCH="${MATCH//\{version\}/$VERSION}"

# SETUP_PLATFORM lets CI or a test force a platform (windows|linux|macos).
case "${SETUP_PLATFORM:-$(uname -s)}" in
  linux|Linux*) PLATFORM=linux ;;
  macos|Darwin*) PLATFORM=macos ;;
  windows|MINGW*|MSYS*|CYGWIN*) PLATFORM=windows ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

case "$PLATFORM" in
@@PLATFORM_CASES@@
esac

# Already set up at the right version? (compare against the version command's
# own output - its punctuation often differs from the release tag.)
if [ -x "$SHIM" ] && "$SHIM" @@VERSION_ARGS@@ 2>/dev/null | grep -qF -- "$MATCH"; then
  echo "@@TOOL@@ $VERSION already set up at $SHIM"
  exit 0
fi

echo "Setting up @@TOOL@@ $VERSION at $BIN_DIR ..."
mkdir -p "$BIN_DIR"
ARCHIVE_PATH="$(mktemp)"
trap 'rm -f "$ARCHIVE_PATH"' EXIT

echo "Downloading $URL"
curl -fsSL -o "$ARCHIVE_PATH" "$URL"

echo "Extracting..."
case "$ARCHIVE" in
  zip)    unzip -oq "$ARCHIVE_PATH" -d "$BIN_DIR" ;;
  tar.gz) tar -xzf "$ARCHIVE_PATH" -C "$BIN_DIR" ;;
  *) echo "Unknown archive type: $ARCHIVE" >&2; exit 1 ;;
esac

[ -e "$BIN_DIR/$BIN_REL" ] || { echo "Expected $BIN_DIR/$BIN_REL after extract - archive layout changed?" >&2; exit 1; }
chmod +x "$BIN_DIR/$BIN_REL" 2>/dev/null || true

# Stable, version-agnostic launcher (relative path, so a moved checkout works).
printf '#!/bin/sh\nexec "$(dirname "$0")/%s" "$@"\n' "$BIN_REL" > "$SHIM"
chmod +x "$SHIM"

echo "Done. @@TOOL@@ $VERSION is at $SHIM"
