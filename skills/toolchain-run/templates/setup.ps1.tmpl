#Requires -Version 5.1
<#
Sets up the @@TOOL@@ version pinned in @@PIN_FILE@@ under @@BIN_DIR@@/ (git-
ignored), so nobody needs to install it system-wide or edit their PATH.
Idempotent: re-running when the right version is already wired up does
nothing. Produces a stable launcher at @@BIN_DIR@@\@@NAME@@.cmd regardless of
the archive's internal layout. See the "run" skill
(.claude/skills/run/SKILL.md) for the commands that use it.

Order of preference (the pinned version always wins - a candidate is only
used if it reports exactly the pinned version):
  1. already set up here at the right version  -> nothing to do
  2. -Existing <folder-or-exe>                 -> use it, or fail loudly
  3. $env:@@ENVVAR@@                   -> use it if it matches, else ignore
  4. @@PATH_NAMES_DISPLAY@@ on PATH            -> use it if it matches, else ignore
  5. download the pinned version

Usage:
  .\tools\setup-@@NAME@@.ps1
  .\tools\setup-@@NAME@@.ps1 -Existing C:\path\to\an\install

Generated by the toolchain-run skill - edit the spec and re-render rather
than hand-editing where possible.
#>
param(
    [string]$Existing = ""
)

$ErrorActionPreference = "Stop"

$repoRoot = Split-Path -Parent $PSScriptRoot
$version = (Get-Content (Join-Path $repoRoot "@@PIN_FILE@@") -Raw).Trim()
$versionCore = $version.Split('-')[0]
$binDir = Join-Path $repoRoot "@@BIN_DIR@@"
$shim = Join-Path $binDir "@@NAME@@.cmd"
$match = '@@VERSION_MATCH@@'.Replace('{version_core}', $versionCore).Replace('{version}', $version)

$url = '@@WIN_URL@@'.Replace('{version}', $version)
$archive = '@@WIN_ARCHIVE@@'
$binRel = '@@WIN_BIN@@'.Replace('{version}', $version)
$binRelWin = $binRel.Replace('/', '\')

# Does this executable report the pinned version? A GUI-subsystem exe whose
# output can't be captured returns nothing and so (safely) counts as a mismatch.
function Get-ToolVersion([string]$exe) {
    try { return ((& $exe @@VERSION_ARGS_PS@@ 2>$null) | Out-String) } catch { return "" }
}

# Wire an existing install: nothing is copied, a small launcher is written.
# $strict = fail loudly (an explicit -Existing); otherwise skip quietly.
function Use-Existing([string]$candidate, [bool]$strict) {
    if (Test-Path $candidate -PathType Container) {
        $candidate = Join-Path $candidate (Split-Path $binRel -Leaf)
    }
    if (-not (Test-Path $candidate)) {
        if ($strict) { throw "Expected '$candidate' but it isn't there." }
        return $false
    }
    $got = Get-ToolVersion $candidate
    if ($got -like "*$match*") {
        New-Item -ItemType Directory -Force -Path $binDir | Out-Null
        @"
@echo off
"$candidate" %*
"@ | Set-Content -Path $shim -Encoding ASCII
        Write-Host "@@TOOL@@ $version wired to existing install: $candidate"
        Write-Host "Launcher: $shim (git-ignored, machine-specific)"
        return $true
    }
    $first = ($got -split "`r?`n" | Select-Object -First 1)
    if ($strict) {
        throw "'$candidate' reports '$first' but @@PIN_FILE@@ pins $version. Not using it. Update @@PIN_FILE@@ deliberately, or point -Existing at a matching install."
    }
    Write-Host "Found @@TOOL@@ at $candidate reporting '$first', but this project pins $version - ignoring it."
    return $false
}

# 2. An explicit -Existing is a deliberate act: always re-validate, never skip.
if ($Existing -ne "") {
    [void](Use-Existing $Existing $true)
    exit 0
}

# 1. Already set up at the right version?
if (Test-Path $shim) {
    if ((Get-ToolVersion $shim) -like "*$match*") {
        Write-Host "@@TOOL@@ $version already set up at $shim"
        exit 0
    }
}

# 3. Environment variable.
$fromEnv = $env:@@ENVVAR@@
if ($fromEnv) { if (Use-Existing $fromEnv $false) { exit 0 } }

# 4. On PATH.
foreach ($n in @(@@PATH_NAMES_PS@@)) {
    $cmd = Get-Command $n -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($cmd -and ($cmd.Source -ne $shim)) { if (Use-Existing $cmd.Source $false) { exit 0 } }
}

# 5. Download the pinned version.
Write-Host "Setting up @@TOOL@@ $version at $binDir ..."
New-Item -ItemType Directory -Force -Path $binDir | Out-Null

$archivePath = Join-Path $env:TEMP ("@@NAME@@-$version." + $archive)
Write-Host "Downloading $url"
Invoke-WebRequest -Uri $url -OutFile $archivePath

Write-Host "Extracting..."
if ($archive -eq 'zip') {
    Expand-Archive -Path $archivePath -DestinationPath $binDir -Force
} elseif ($archive -eq 'tar.gz') {
    tar -xzf $archivePath -C $binDir
} else {
    throw "Unknown archive type: $archive"
}
Remove-Item $archivePath

$realBin = Join-Path $binDir $binRel
if (-not (Test-Path $realBin)) {
    throw "Expected $realBin after extract - archive layout changed?"
}

# Stable, version-agnostic launcher. Some tools (see examples/godot.spec.json)
# refuse to run if renamed, so this forwards to the real binary under its own
# name instead of aliasing/renaming it.
@"
@echo off
"%~dp0$binRelWin" %*
"@ | Set-Content -Path $shim -Encoding ASCII

Write-Host "Done. @@TOOL@@ $version is at $shim"
