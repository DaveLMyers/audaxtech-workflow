#Requires -Version 5.1
<#
Fetches the @@TOOL@@ version pinned in @@PIN_FILE@@ into @@BIN_DIR@@/ (git-
ignored), so nobody needs to install it system-wide or edit their PATH.
Idempotent - re-running when the right version is already present does
nothing. Produces a stable launcher at @@BIN_DIR@@\@@NAME@@.cmd regardless of
the archive's internal layout. See the "run" skill
(.claude/skills/run/SKILL.md) for the commands that use it.

Generated by the toolchain-run skill - edit the spec and re-render rather
than hand-editing where possible.
#>

$ErrorActionPreference = "Stop"

$repoRoot = Split-Path -Parent $PSScriptRoot
$version = (Get-Content (Join-Path $repoRoot "@@PIN_FILE@@") -Raw).Trim()
$versionCore = $version.Split('-')[0]
$binDir = Join-Path $repoRoot "@@BIN_DIR@@"
$shim = Join-Path $binDir "@@NAME@@.cmd"
$match = '@@VERSION_MATCH@@'.Replace('{version_core}', $versionCore).Replace('{version}', $version)

$url = '@@WIN_URL@@'.Replace('{version}', $version)
$archive = '@@WIN_ARCHIVE@@'
$binRel = '@@WIN_BIN@@'.Replace('{version}', $version)

if (Test-Path $shim) {
    $existing = (& $shim @@VERSION_ARGS_PS@@ 2>$null | Out-String)
    if ($existing -like "*$match*") {
        Write-Host "@@TOOL@@ $version already set up at $shim"
        exit 0
    }
}

Write-Host "Setting up @@TOOL@@ $version at $binDir ..."
New-Item -ItemType Directory -Force -Path $binDir | Out-Null

$archivePath = Join-Path $env:TEMP ("@@NAME@@-$version." + $archive)
Write-Host "Downloading $url"
Invoke-WebRequest -Uri $url -OutFile $archivePath

Write-Host "Extracting..."
if ($archive -eq 'zip') {
    Expand-Archive -Path $archivePath -DestinationPath $binDir -Force
} elseif ($archive -eq 'tar.gz') {
    tar -xzf $archivePath -C $binDir
} else {
    throw "Unknown archive type: $archive"
}
Remove-Item $archivePath

$realBin = Join-Path $binDir $binRel
if (-not (Test-Path $realBin)) {
    throw "Expected $realBin after extract - archive layout changed?"
}

# Stable, version-agnostic launcher. Some tools (see the Godot recipe) refuse
# to run if renamed, so this forwards to the real binary under its own name
# instead of aliasing/renaming it.
$binRelWin = $binRel.Replace('/', '\')
@"
@echo off
"%~dp0$binRelWin" %*
"@ | Set-Content -Path $shim -Encoding ASCII

Write-Host "Done. @@TOOL@@ $version is at $shim"
